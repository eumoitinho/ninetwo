{
  "$schema": "https://json.schemastore.org/swcrc",
  "sourceMaps": true,
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "baseUrl": "./",
    "paths": {
      "src/*": ["./src/*"]
    },
    "experimental": {
      "plugins": [
        [
          "@lingui/swc-plugin",
          {
            "stripNonEssentialFields": false
          }
        ]
      ]
    }
  },
  "minify": false
}
